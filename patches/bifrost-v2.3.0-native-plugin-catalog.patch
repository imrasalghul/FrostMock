+// The background entry point must load BasePlugins and key policy from the same
+// custom-provider config used by live catalog refresh, rather than its LLM cache.
+func TestCatalogProviderPluginServerLoadsAtomicSnapshotAndSelectedKeyPolicy(t *testing.T) {
+	keyID := "subscription-key"
+	key := schemas.Key{ID: keyID, Models: schemas.WhiteList{"live-a"}}
+	cfg := &lib.Config{Providers: map[schemas.ModelProvider]configstore.ProviderConfig{"subscription": {Keys: []schemas.Key{key}, CustomProviderConfig: &schemas.CustomProviderConfig{}}}}
+	want := &schemas.BifrostListModelsResponse{Data: []schemas.Model{{ID: "subscription/live-a"}, {ID: "subscription/live-b"}}, KeyStatuses: []schemas.KeyStatus{{KeyID: keyID, Provider: "subscription", Status: schemas.KeyStatusSuccess}}}
+	calls := 0
+	owner := &catalogAdapterPlugin{name: "subscription", pre: func(_ *schemas.BifrostContext, req *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+		calls++
+		if req.RequestType != schemas.ListModelsRequest || req.ListModelsRequest.KeyID == nil || *req.ListModelsRequest.KeyID != keyID {
+			t.Fatalf("wrong native catalog request: %+v", req)
+		}
+		return nil, &schemas.LLMPluginShortCircuit{Response: &schemas.BifrostResponse{ListModelsResponse: want}}, nil
+	}}
+	plugins := []schemas.BasePlugin{owner}
+	cfg.BasePlugins.Store(&plugins)
+	server := &BifrostHTTPServer{Config: cfg}
+	ctx := schemas.NewBifrostContext(context.Background(), time.Time{})
+	defer ctx.Cancel()
+	ctx.SetValue(schemas.BifrostContextKeySkipPluginPipeline, true)
+	for _, unfiltered := range []bool{false, true} {
+		got, bfErr := server.listModelsForCatalog(ctx, &schemas.BifrostListModelsRequest{Provider: "subscription", KeyID: &keyID, Unfiltered: unfiltered})
+		if bfErr != nil || got == nil {
+			t.Fatalf("native listing error=%v response=%v", bfErr, got)
+		}
+		expected := 1
+		if unfiltered {
+			expected = 2
+		}
+		if len(got.Data) != expected || len(got.KeyStatuses) != 1 || got.KeyStatuses[0].KeyID != keyID {
+			t.Fatalf("native catalog response=%+v unfiltered=%v", got, unfiltered)
+		}
+	}
+	if calls != 2 || len(want.Data) != 2 {
+		t.Fatalf("hook calls=%d shared models=%d", calls, len(want.Data))
+	}
+}
