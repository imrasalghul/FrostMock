+// The provider catalog adapter must never invoke governance, routing, or post hooks.
+type catalogAdapterPlugin struct {
+	name string
+	pre  func(*schemas.BifrostContext, *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error)
+}
+
+func (p *catalogAdapterPlugin) GetName() string { return p.name }
+func (p *catalogAdapterPlugin) Cleanup() error  { return nil }
+func (p *catalogAdapterPlugin) PreRequestHook(*schemas.BifrostContext, *schemas.BifrostRequest) error {
+	panic("catalog must not run request hooks")
+}
+func (p *catalogAdapterPlugin) PreLLMHook(ctx *schemas.BifrostContext, req *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+	return p.pre(ctx, req)
+}
+func (p *catalogAdapterPlugin) PostLLMHook(*schemas.BifrostContext, *schemas.BifrostResponse, *schemas.BifrostError) (*schemas.BifrostResponse, *schemas.BifrostError, error) {
+	panic("catalog must not run post hooks")
+}
+
+type catalogAdapterBasePlugin struct{ name string }
+
+func (p catalogAdapterBasePlugin) GetName() string { return p.name }
+func (p catalogAdapterBasePlugin) Cleanup() error  { return nil }
