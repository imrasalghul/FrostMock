+func TestCatalogProviderPluginFallthroughAndErrors(t *testing.T) {
+	SetLogger(bifrost.NewNoOpLogger())
+	denied := &schemas.BifrostError{Error: &schemas.ErrorField{Message: "catalog denied"}, ExtraFields: schemas.BifrostErrorExtraFields{KeyStatuses: []schemas.KeyStatus{{KeyID: "key", Status: schemas.KeyStatusListModelsFailed}}}}
+	fallbackError := &schemas.BifrostError{Error: &schemas.ErrorField{Message: "ordinary provider error"}}
+	for _, tc := range []struct {
+		name, pluginName string
+		short            *schemas.LLMPluginShortCircuit
+		hookError        error
+		wantDenied       bool
+		noPlugins        bool
+		emptyProvider    bool
+	}{
+		{name: "short-circuit error", pluginName: "subscription", short: &schemas.LLMPluginShortCircuit{Error: denied}, wantDenied: true},
+		{name: "unhandled", pluginName: "subscription"},
+		{name: "empty short circuit", pluginName: "subscription", short: &schemas.LLMPluginShortCircuit{}},
+		{name: "different response type", pluginName: "subscription", short: &schemas.LLMPluginShortCircuit{Response: &schemas.BifrostResponse{}}},
+		{name: "hook error is nonblocking", pluginName: "subscription", hookError: errors.New("hook unavailable")},
+		{name: "other provider", pluginName: "another-provider"},
+		{name: "provider prefix is not a match", pluginName: "subscription-extra"},
+		{name: "provider matching is exact", pluginName: "Subscription"},
+		{name: "no eligible plugins", noPlugins: true},
+		{name: "empty provider", pluginName: "", emptyProvider: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := schemas.NewBifrostContext(context.Background(), time.Time{})
+			defer ctx.Cancel()
+			key := "key"
+			req := &schemas.BifrostListModelsRequest{Provider: "subscription", KeyID: &key, Unfiltered: true}
+			if tc.emptyProvider {
+				req.Provider = ""
+			}
+			calls := 0
+			plugin := &catalogAdapterPlugin{name: tc.pluginName, pre: func(*schemas.BifrostContext, *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+				calls++
+				return &schemas.BifrostRequest{}, tc.short, tc.hookError
+			}}
+			plugins := []schemas.BasePlugin{plugin}
+			var eligible *[]schemas.BasePlugin
+			if !tc.noPlugins {
+				eligible = &plugins
+			}
+			fallbackCalls := 0
+			fallback := func(gotCtx *schemas.BifrostContext, got *schemas.BifrostListModelsRequest) (*schemas.BifrostListModelsResponse, *schemas.BifrostError) {
+				fallbackCalls++
+				if gotCtx != ctx || got != req {
+					t.Fatal("ordinary provider lost original context or request")
+				}
+				return nil, fallbackError
+			}
+			got, bfErr, _ := listModelsWithProviderPlugin(ctx, req, eligible, fallback)
+			if tc.wantDenied {
+				if got != nil || bfErr != denied || fallbackCalls != 0 || calls != 1 {
+					t.Fatalf("short-circuit error lost: got=%v error=%v fallback=%d hooks=%d", got, bfErr, fallbackCalls, calls)
+				}
+			} else {
+				if got != nil || bfErr != fallbackError || fallbackCalls != 1 {
+					t.Fatalf("ordinary fallback changed: response=%v error=%v calls=%d", got, bfErr, fallbackCalls)
+				}
+				if (tc.noPlugins || tc.emptyProvider || tc.pluginName != "subscription") && calls != 0 {
+					t.Fatalf("unmatched plugin executed %d times", calls)
+				}
+			}
+		})
+	}
+}
