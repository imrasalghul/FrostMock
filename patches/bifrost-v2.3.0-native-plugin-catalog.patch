+func TestCatalogProviderPluginAppliesKeyModelPolicyWithoutMutatingSharedResponse(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		key        schemas.Key
+		unfiltered bool
+		want       []string
+		alias      string
+	}{
+		{name: "allowlist aliases and blacklist", key: schemas.Key{Models: schemas.WhiteList{"alias", "manual"}, BlacklistedModels: schemas.BlackList{"manual"}, Aliases: schemas.KeyAliases{"alias": {ModelID: "live-a"}}}, want: []string{"subscription/alias"}, alias: "live-a"},
+		{name: "wildcard blacklist", key: schemas.Key{Models: schemas.WhiteList{"*"}, BlacklistedModels: schemas.BlackList{"live-b"}}, want: []string{"subscription/live-a"}},
+		{name: "empty allowlist denies all", key: schemas.Key{}, want: []string{}},
+		{name: "regex whitelist", key: schemas.Key{Models: schemas.WhiteList{"regex:live-a"}}, want: []string{"subscription/live-a"}},
+		{name: "configured model backfill", key: schemas.Key{Models: schemas.WhiteList{"manual"}}, want: []string{"subscription/manual"}},
+		{name: "unfiltered ignores allow and block", key: schemas.Key{BlacklistedModels: schemas.BlackList{"*"}}, unfiltered: true, want: []string{"subscription/live-a", "subscription/live-b"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			contextLength := 12345
+			original := &schemas.BifrostListModelsResponse{Data: []schemas.Model{{ID: "subscription/live-a", ContextLength: &contextLength}, {ID: "subscription/live-b"}, {ID: "openai/foreign-model"}}, KeyStatuses: []schemas.KeyStatus{{KeyID: "key", Provider: "subscription", Status: schemas.KeyStatusSuccess}}}
+			req := &schemas.BifrostListModelsRequest{Provider: "subscription", Unfiltered: tc.unfiltered}
+			got := filterProviderPluginCatalog(original, req, tc.key)
+			ids := make([]string, 0, len(got.Data))
+			for _, m := range got.Data {
+				ids = append(ids, m.ID)
+			}
+			if !reflect.DeepEqual(ids, tc.want) {
+				t.Fatalf("filtered IDs=%v want %v", ids, tc.want)
+			}
+			if len(original.Data) != 3 || original.Data[0].ID != "subscription/live-a" {
+				t.Fatal("key policy mutated shared plugin response")
+			}
+			if len(got.KeyStatuses) != 1 || got.KeyStatuses[0].Status != schemas.KeyStatusSuccess {
+				t.Fatal("filter discarded key statuses")
+			}
+			if tc.alias != "" && (got.Data[0].Alias == nil || *got.Data[0].Alias != tc.alias || got.Data[0].ContextLength != &contextLength) {
+				t.Fatalf("alias lost source metadata: %+v", got.Data[0])
+			}
+		})
+	}
+}
