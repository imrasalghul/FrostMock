+func TestCatalogProviderPluginListsModelsWithoutGlobalPipeline(t *testing.T) {
+	for _, unfiltered := range []bool{false, true} {
+		t.Run(map[bool]string{false: "filtered", true: "unfiltered"}[unfiltered], func(t *testing.T) {
+			ctx := schemas.NewBifrostContext(context.Background(), time.Time{})
+			defer ctx.Cancel()
+			ctx.SetValue(schemas.BifrostContextKeySkipPluginPipeline, true)
+			keyID := "subscription-key"
+			req := &schemas.BifrostListModelsRequest{Provider: "subscription", KeyID: &keyID, Unfiltered: unfiltered, PageSize: 17, PageToken: "cursor"}
+			want := &schemas.BifrostListModelsResponse{Data: []schemas.Model{{ID: "subscription/live-model"}}, KeyStatuses: []schemas.KeyStatus{{KeyID: keyID, Provider: "subscription", Status: "success"}}}
+			calls := 0
+			owner := &catalogAdapterPlugin{name: "subscription", pre: func(gotCtx *schemas.BifrostContext, got *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+				calls++
+				if gotCtx != ctx || got.RequestType != schemas.ListModelsRequest || !reflect.DeepEqual(got.ListModelsRequest, req) {
+					t.Fatalf("catalog hook received wrong request: %+v", got)
+				}
+				return nil, &schemas.LLMPluginShortCircuit{Response: &schemas.BifrostResponse{ListModelsResponse: want}}, nil
+			}}
+			forbidden := &catalogAdapterPlugin{name: "governance", pre: func(*schemas.BifrostContext, *schemas.BifrostRequest) (*schemas.BifrostRequest, *schemas.LLMPluginShortCircuit, error) {
+				t.Fatal("global governance hook ran")
+				return nil, nil, nil
+			}}
+			plugins := []schemas.BasePlugin{forbidden, catalogAdapterBasePlugin{name: "subscription"}, owner}
+			fallback := func(*schemas.BifrostContext, *schemas.BifrostListModelsRequest) (*schemas.BifrostListModelsResponse, *schemas.BifrostError) {
+				t.Error("generic provider called for owned catalog")
+				return nil, nil
+			}
+			got, bfErr, _ := listModelsWithProviderPlugin(ctx, req, &plugins, fallback)
+			if got != want || bfErr != nil || calls != 1 {
+				t.Fatalf("catalog response=%+v error=%v calls=%d", got, bfErr, calls)
+			}
+			if ctx.Value(schemas.BifrostContextKeySkipPluginPipeline) != true {
+				t.Fatal("catalog enabled the global pipeline")
+			}
+		})
+	}
+}
