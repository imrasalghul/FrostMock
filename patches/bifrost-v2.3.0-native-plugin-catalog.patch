+// listModelsForCatalog lets a custom provider's owning native LLM plugin supply
+// its background catalog without enabling the global plugin pipeline. Existing
+// key status updates, filtering, and catalog generation checks stay in the caller.
+// This runs only during discovery and adds no work to the inference request path.
+func (s *BifrostHTTPServer) listModelsForCatalog(ctx *schemas.BifrostContext, req *schemas.BifrostListModelsRequest) (*schemas.BifrostListModelsResponse, *schemas.BifrostError) {
+	var plugins *[]schemas.BasePlugin
+	var selectedKey *schemas.Key
+	if s.Config != nil && req != nil {
+		if pc, err := s.Config.GetProviderConfigRaw(req.Provider); err == nil && pc != nil && pc.CustomProviderConfig != nil {
+			plugins = s.Config.BasePlugins.Load()
+			if req.KeyID != nil {
+				for _, key := range pc.Keys {
+					if key.ID == *req.KeyID && keyEnabled(key) {
+						selectedKey = &key
+						break
+					}
+				}
+				// Retain core's validation for a missing or disabled selected key.
+				if selectedKey == nil {
+					plugins = nil
+				}
+			}
+		}
+	}
+	resp, bfErr, owned := listModelsWithProviderPlugin(ctx, req, plugins, s.Client.ListModelsRequest)
+	if owned && resp != nil && selectedKey != nil {
+		resp = filterProviderPluginCatalog(resp, req, *selectedKey)
+	}
+	return resp, bfErr
+}
+
+// listModelsWithProviderPlugin uses the immutable plugin snapshot loaded by the
+// server. Exact name matching is deliberate: unrelated policy, governance, and
+// observability plugins must not receive an internal catalog refresh.
+func listModelsWithProviderPlugin(ctx *schemas.BifrostContext, req *schemas.BifrostListModelsRequest, plugins *[]schemas.BasePlugin, fallback func(*schemas.BifrostContext, *schemas.BifrostListModelsRequest) (*schemas.BifrostListModelsResponse, *schemas.BifrostError)) (*schemas.BifrostListModelsResponse, *schemas.BifrostError, bool) {
+	if req != nil && req.Provider != "" && plugins != nil {
+		for _, base := range *plugins {
+			if base == nil || base.GetName() != string(req.Provider) {
+				continue
+			}
+			plugin, ok := base.(schemas.LLMPlugin)
+			if !ok {
+				continue
+			}
+			// Keep the original request for ordinary provider fallback if the owning
+			// plugin declines to supply a list, rather than applying routing mutations.
+			pluginReq := *req
+			_, short, err := plugin.PreLLMHook(ctx, &schemas.BifrostRequest{RequestType: schemas.ListModelsRequest, ListModelsRequest: &pluginReq})
+			if err != nil {
+				// Hook errors are non-blocking, consistent with the normal plugin contract.
+				logger.Warn("provider catalog hook failed for plugin %s: %v", base.GetName(), err)
+				break
+			}
+			if short != nil {
+				if short.Error != nil {
+					return nil, short.Error, true
+				}
+				if short.Response != nil && short.Response.ListModelsResponse != nil {
+					return short.Response.ListModelsResponse, nil, true
+				}
+			}
+			break
+		}
+	}
+	resp, bfErr := fallback(ctx, req)
+	return resp, bfErr, false
+}
+
+// The composed model catalog trusts filtered live responses, so plugin lists
+// need the same key policy that provider converters normally apply. Reuse that
+// shared pipeline, preserving aliases, explicit-model backfill, and metadata.
+// Copy the response because a plugin may share its catalog across both calls.
+func filterProviderPluginCatalog(resp *schemas.BifrostListModelsResponse, req *schemas.BifrostListModelsRequest, key schemas.Key) *schemas.BifrostListModelsResponse {
+	filtered := *resp
+	filtered.Data = make([]schemas.Model, 0, len(resp.Data))
+	pipeline := &providerUtils.ListModelsPipeline{AllowedModels: key.Models, BlacklistedModels: key.BlacklistedModels, Aliases: key.Aliases, Unfiltered: req.Unfiltered, ProviderKey: req.Provider, MatchFns: providerUtils.DefaultMatchFns()}
+	if pipeline.ShouldEarlyExit() {
+		return &filtered
+	}
+	included := make(map[string]bool, len(resp.Data))
+	for _, model := range resp.Data {
+		provider, _ := schemas.ParseModelString(model.ID, "")
+		id := strings.TrimPrefix(model.ID, string(req.Provider)+"/")
+		if provider != "" && provider != req.Provider {
+			continue
+		}
+		for _, result := range pipeline.FilterModel(id) {
+			entry := model
+			entry.ID = string(req.Provider) + "/" + result.ResolvedID
+			if result.AliasValue != "" {
+				entry.Alias = schemas.Ptr(result.AliasValue)
+			}
+			filtered.Data = append(filtered.Data, entry)
+			included[strings.ToLower(result.ResolvedID)] = true
+		}
+	}
+	filtered.Data = append(filtered.Data, pipeline.BackfillModels(included)...)
+	return &filtered
+}
